# Copy to .env and fill in. Never commit .env.
# Needed only for live model calls: `prospect run`, `extract`, `score`, `eval extract` and
# `prospect demo --record`. `prospect demo` and the tests run without a key.
# Keep the key here rather than exporting it in your shell profile: config.py reads this file
# directly and never puts the key into the environment of child processes.
ANTHROPIC_API_KEY=
